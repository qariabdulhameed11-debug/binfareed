# Server Configuration
PORT=5005
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/binfareedstore?retryWrites=true&w=majority

# Authentication & Security Secrets
JWT_SECRET=replace_with_a_strong_64_char_random_hex_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Cloudinary Image Storage (Required on Vercel Serverless)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway Integration
PAYMENT_PROVIDER=safepay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# Default Admin Credentials
ADMIN_EMAIL=admin@binfareedstore.pk
ADMIN_PASSWORD=Admin@BinFareed2026!

# AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Frontend Configuration
# Leave blank on Vercel or local dev so relative '/api' calls hit the same domain/proxy
VITE_API_URL=
VITE_SITE_URL=http://localhost:5174
